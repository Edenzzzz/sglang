+  params.q = static_cast<__nv_bfloat16*>(q.data_ptr());
+  params.paged_kv = flashinfer::paged_kv_t<__nv_bfloat16, int32_t>(
+      kv_heads, k_cache.size(1), 128, batch, flashinfer::QKVLayout::kNHD,
+      static_cast<__nv_bfloat16*>(k_cache.data_ptr()),
+      static_cast<__nv_bfloat16*>(v_cache.data_ptr()),
+      k_cache.strides().data(), v_cache.strides().data(), kv_indices.data_ptr<int32_t>(),
+      kv_indptr.data_ptr<int32_t>(), last_page_len.data_ptr<int32_t>());
+  params.q_indptr = qo_indptr.data_ptr<int32_t>();
+  params.o = static_cast<__nv_bfloat16*>(output.data_ptr());
+  params.lse = lse.numel() == 0 ? nullptr : lse.data_ptr<float>();
+  params.num_qo_heads = heads;
+  params.group_size = flashinfer::uint_fastdiv(heads / kv_heads);
+  params.q_stride_n = q.stride(0);
+  params.q_stride_h = q.stride(1);
+  params.sm_scale = sm_scale;
+  params.request_indices = flashinfer::GetPtrFromBaseOffset<int32_t>(integer_buffer, plan.request_indices_offset);
+  params.qo_tile_indices = flashinfer::GetPtrFromBaseOffset<int32_t>(integer_buffer, plan.qo_tile_indices_offset);
+  params.kv_tile_indices = flashinfer::GetPtrFromBaseOffset<int32_t>(integer_buffer, plan.kv_tile_indices_offset);
+  params.o_indptr = flashinfer::GetPtrFromBaseOffset<int32_t>(integer_buffer, plan.o_indptr_offset);
+  params.kv_chunk_size_ptr = flashinfer::GetPtrFromBaseOffset<int32_t>(integer_buffer, plan.kv_chunk_size_ptr_offset);
+  params.padded_batch_size = plan.padded_batch_size;
+  params.max_total_num_rows = plan.total_num_rows;
+  params.independent_pdl = independent_pdl;
+  params.pdl_timeline = timeline.numel() == 0 ? nullptr :
+      reinterpret_cast<unsigned long long*>(timeline.data_ptr<int64_t>());
+  __nv_bfloat16* temporary_output = nullptr;
+  float* temporary_lse = nullptr;
+  if (plan.split_kv) {
+    params.merge_indptr = flashinfer::GetPtrFromBaseOffset<int32_t>(integer_buffer, plan.merge_indptr_offset);
+    temporary_output = flashinfer::GetPtrFromBaseOffset<__nv_bfloat16>(float_buffer, plan.v_offset);
+    temporary_lse = flashinfer::GetPtrFromBaseOffset<float>(float_buffer, plan.s_offset);
+    if (plan.enable_cuda_graph) {
