+#if FLASHINFER_FA3_UPSTREAM
+  UpstreamFA3Kernel<FA3Traits::HEAD_DIM_VO, int32_t>{}(upstream_fa3, reinterpret_cast<char*>(smem));
+#else
+  fa3_prefill_body<FA3Mainloop, FA3Epilogue, FA3Traits, LEFT_SLIDING_WINDOW, CAUSAL,
+                   FA3TileScheduler, false>(fa3_mainloop_params, fa3_epilogue_params,
+                                           fa3_scheduler_params, reinterpret_cast<char*>(smem),
+                                           entry_register_count);
+#endif
+  cute::tma_store_wait<0>();
+  cp_async::wait_group<0>();
+  __syncthreads();
