+def standalone(kind, n, rate):
+    """One standard standalone workload (S3), selected by STANDALONE:
+    sharegpt | sharegpt:<json> | mooncake_toolagent | mooncake_conversation | longbench_v2 |
+    speed_bench:<jsonl>[:<category>] | custom:<jsonl>."""
+    rate_args = ["--request-rate", str(rate), "--num-prompts", str(n)]
+    if kind == "sharegpt":
+        return ["--dataset-name", "sharegpt", "--dataset-path", CHAT_DS] + rate_args
+    if kind.startswith("sharegpt:"):
+        # ShareGPT-format conversions (prep_standalone.py: gsm8k, math500, humaneval,
+        # codefeedback); each request's output length is its reference answer's length.
+        return ["--dataset-name", "sharegpt", "--dataset-path", kind.split(":", 1)[1]] + rate_args
+    if kind.startswith("mooncake_"):
+        return ["--dataset-name", "mooncake", "--mooncake-workload", kind.split("_", 1)[1]] + rate_args
+    if kind == "longbench_v2":
+        return ["--dataset-name", "longbench_v2"] + rate_args
+    if kind.startswith("speed_bench:"):
+        parts = kind.split(":")
+        args = ["--dataset-name", "speed-bench", "--dataset-path", parts[1]]
+        if len(parts) > 2:
+            args += ["--speed-bench-category", parts[2]]
+        return args + rate_args
+    if kind.startswith("custom:"):
+        return ["--dataset-name", "custom", "--dataset-path", kind.split(":", 1)[1]] + rate_args
+    raise ValueError(f"unknown STANDALONE workload {kind!r}")
+
