+
+void native_fa2_run(at::Tensor q, at::Tensor k_cache, at::Tensor v_cache,
+                    at::Tensor qo_indptr, at::Tensor kv_indptr, at::Tensor kv_indices,
+                    at::Tensor last_page_len, at::Tensor output, at::Tensor lse,
+                    at::Tensor float_workspace, at::Tensor int_workspace,
+                    std::vector<int64_t> plan_values, double sm_scale,
+                    bool enable_pdl, bool independent_pdl, at::Tensor timeline) {
+  TORCH_CHECK(q.is_cuda() && q.dim() == 3 && q.size(2) == 128,
+              "native FA2 bridge requires CUDA Q with head dimension 128");
+  TORCH_CHECK(q.scalar_type() == at::kBFloat16 && k_cache.scalar_type() == at::kBFloat16 &&
+              v_cache.scalar_type() == at::kBFloat16 && output.scalar_type() == at::kBFloat16,
+              "native FA2 bridge supports bf16 only");
+  TORCH_CHECK(output.sizes() == q.sizes() && output.is_contiguous(),
+              "native FA2 output must be contiguous and match Q");
+  TORCH_CHECK(!independent_pdl || enable_pdl, "independent work requires a PDL launch");
+  for (const auto& tensor : {k_cache, v_cache, qo_indptr, kv_indptr, kv_indices,
+                            last_page_len, output, lse, float_workspace, int_workspace, timeline}) {
+    TORCH_CHECK(tensor.is_cuda() && tensor.device() == q.device(), "CUDA device mismatch");
+  }
+  for (const auto& tensor : {qo_indptr, kv_indptr, kv_indices, last_page_len}) {
+    TORCH_CHECK(tensor.scalar_type() == at::kInt && tensor.is_contiguous(),
+                "native FA2 index tensors must be contiguous int32");
+  }
+  TORCH_CHECK(float_workspace.scalar_type() == at::kByte &&
+              int_workspace.scalar_type() == at::kByte &&
+              float_workspace.is_contiguous() && int_workspace.is_contiguous(),
+              "native FA2 workspaces must be contiguous byte buffers");
