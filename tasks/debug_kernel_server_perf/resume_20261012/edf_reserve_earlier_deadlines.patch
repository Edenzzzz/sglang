+    def _edf_chunked_req_limit(self, budget):
+        """Reserve this step's prefill budget for waiting requests whose TTFT deadline is earlier
+        than the chunked request's, so a short append is not held behind every remaining chunk of
+        a long prompt. Walks the deadline-ordered queue and stops at the first request that does not
+        fit whole; the chunked request keeps at least one page. None leaves the budget unchanged."""
+        if (not self.edf_enabled or not EDF_RESERVE_EARLIER_DEADLINES
+                or not self.waiting_queue or budget < 2 * self.page_size):
+            return None
+        bound = self.chunked_req.priority
+        if bound is None:
+            return None
+        reserved = 0
+        for req in self.waiting_queue:
+            if req.priority is None or req.priority >= bound:
+                break
+            req.init_next_round_input(self.tree_cache)
+            work = -(-max(1, len(req.full_untruncated_fill_ids) - req.prefix_len) // self.page_size) * self.page_size
+            if reserved + work > budget - self.page_size:
+                break
+            reserved += work
+        if not reserved:
+            return None
+        self.edf_reserve_calls += 1
+        self.edf_reserve_tokens += reserved
+        if self.edf_reserve_calls == 1 or self.edf_reserve_calls % 200 == 0:
+            logger.info("EDF_RESERVE calls=%d reserved=%d budget=%d total_reserved=%d",
+                        self.edf_reserve_calls, reserved, budget, self.edf_reserve_tokens)
+        return (budget - reserved) // self.page_size * self.page_size
+
