+    def test_primary_and_verification_page_metadata(self):
+        kernel, plans, loads, events = self.prepare_primary()
+        self.assertEqual(plans[0][3].tolist(), [0, 7, 39])
+        self.assertEqual(plans[0][4].tolist(), [0, 2, 6])
+        self.assertEqual(plans[0][5].tolist(), [129, 385])
+        self.assertEqual(plans[0][11], 128)
+        self.assertEqual(kernel["kv_indices"].tolist(), [0, 13, 5, 7, 1, 12])
+        self.assertEqual(kernel["verify_q_indptr"].tolist(), [0, 7, 11, 43, 51])
+        self.assertEqual(kernel["verify_kv_indptr"].tolist(), [0, 2, 3, 7, 10])
+        self.assertEqual(kernel["verify_kv_indices"].tolist(), [0, 13, 8, 5, 7, 1, 12, 6, 11, 4])
+        self.assertEqual(kernel["max_pages"], 4)
+        self.assertEqual(loads, [{"cta_q": 128}, {"cta_q": 128}])
+        self.assertEqual(events, ["build", "record", "wait", "build", "record"])
+
+    def test_small_query_honors_explicit_tile(self):
+        kernel, _, loads, _ = self.prepare_primary(primary_rows=(0,))
+        self.assertEqual(kernel["fa3_cta_q"], 128)
