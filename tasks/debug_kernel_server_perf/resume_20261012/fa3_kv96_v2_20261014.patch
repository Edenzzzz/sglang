+  const int64_t aligned = ((int64_t(chunk) + alignment - 1) / alignment) * alignment;
+  if (aligned > std::numeric_limits<int32_t>::max()) {
+    FLASHINFER_ERROR("aligned FA3 KV chunk exceeds int32 range");
+  }
+  return int32_t(aligned);
+}
