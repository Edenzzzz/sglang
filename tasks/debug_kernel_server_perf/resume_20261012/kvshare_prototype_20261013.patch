+inline std::vector<int32_t> FusedPairFa3WorkItems(std::vector<FusedWorkItem>& items,
+                                                uint32_t cta_count) {
+  if (cta_count == 0 || cta_count % 2 != 0) {
+    FLASHINFER_ERROR("FA3 KV sharing requires a positive even CTA count");
+  }
+  std::vector<std::vector<FusedWorkItem>> assignments(cta_count);
+  for (size_t index = 0; index < items.size(); ++index) {
+    const size_t cluster = (index / 2) % (cta_count / 2);
+    assignments[2 * cluster + index % 2].push_back(items[index]);
+  }
+  std::vector<int32_t> offsets(cta_count + 1, 0);
+  items.clear();
+  for (uint32_t cta = 0; cta < cta_count; ++cta) {
+    items.insert(items.end(), assignments[cta].begin(), assignments[cta].end());
+    offsets[cta + 1] = int32_t(items.size());
+  }
+  return offsets;
+}
