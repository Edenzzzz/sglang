+  IdType* o_indptr = nullptr;
+  bool* block_valid_mask = nullptr;
+  IdType* kv_chunk_size_ptr = nullptr;
+  uint32_t max_total_num_rows = 0;
+  uint32_t* total_num_rows = nullptr;
+  uint32_t padded_batch_size = 0;
+  bool partition_kv = false;
+  bool independent_pdl = false;
+  unsigned long long* pdl_timeline = nullptr;
+
+  __host__ __device__ __forceinline__ uint32_t get_qo_len(uint32_t batch_idx) const {
+    return q_indptr[batch_idx + 1] - q_indptr[batch_idx];
+  }
+
+  __host__ __device__ __forceinline__ uint32_t get_kv_len(uint32_t batch_idx) const {
+    return paged_kv.get_length(batch_idx);
+  }
