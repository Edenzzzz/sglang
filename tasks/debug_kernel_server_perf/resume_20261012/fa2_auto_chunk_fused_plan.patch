 // Guarded so the struct above stays host-checkable: port07/tests/run_host_checks.sh compiles
 // this header with plain g++ to assert the ToVector/FromVector round-trip, and `cudaError_t`
 // does not exist there. The declaration is only needed by the CUDA translation units.
+// FA2 split-KV chunk for FUSED_FA2_KV_CHUNK=auto. Sized so the FA2 item count roughly matches the
+// CTA slots the FA2 role can occupy: every SM when the batch has no FA3 work, otherwise the
+// 2 x (num_sm - sm_split) slots left beside the FA3 grid (FA3 CTAs vacate theirs only at the end).
+// Fewer, longer items starve a small batch of parallelism; more, shorter ones pay per-item and
+// merge cost on a large one. Measured under the co-launch, classes 64/32/16
+// (colaunch_chunk_20261012): the fixed best chunk ranged 256..2048 across seven fixtures and this
+// rule picks the best or within 3% of it on each. A power of two >= 256, so a chunk boundary never
+// falls inside a 128-key tile.
+inline int32_t FusedAutoFa2KvChunk(const int32_t* qo_lens, const int32_t* kv_lens,
+                                   const bool* fa3_mask, uint32_t batch_size,
+                                   uint32_t gqa_group_size, uint32_t num_kv_heads,
+                                   uint32_t largest_fa2_tile, uint32_t num_sm, uint32_t sm_split) {
+  int64_t work = 0;
+  bool has_fa3 = false;
+  for (uint32_t i = 0; i < batch_size; ++i) {
+    if (fa3_mask != nullptr && fa3_mask[i]) {
+      has_fa3 = true;
+      continue;
+    }
+    const int64_t packed = int64_t(qo_lens[i]) * gqa_group_size;
+    const int64_t tiles = (packed + largest_fa2_tile - 1) / largest_fa2_tile;
+    work += int64_t(num_kv_heads) * tiles * int64_t(kv_lens[i] > 0 ? kv_lens[i] : 1);
+  }
+  const int64_t free_sms = has_fa3 && sm_split < num_sm ? int64_t(num_sm - sm_split) : 0;
+  const int64_t slots = has_fa3 ? std::max<int64_t>(2 * free_sms, 1) : int64_t(num_sm);
+  const int64_t want = (work + slots - 1) / slots;
+  int64_t chunk = 256;
+  while (chunk < want) chunk *= 2;
+  return int32_t(std::min<int64_t>(chunk, int64_t(1) << 30));
+}
