+
+SOURCE = Path(__file__).parent / "up_racefix/python/sglang/srt/layers/attention/flashinfer_backend.py"
+
+
+def extract_method(name, environment):
+    syntax = ast.parse(SOURCE.read_text())
+    method = next(node for node in ast.walk(syntax)
+                  if isinstance(node, ast.FunctionDef) and node.name == name)
+    executable = ast.fix_missing_locations(ast.Module(body=[method], type_ignores=[]))
+    exec(compile(executable, str(SOURCE), "exec"), environment)
+    return environment[name]
+
+
+def request_fixture(page_size):
+    if page_size == 128:
+        pages = torch.tensor([[8, 3, 10, 2], [6, 11, 4, 9],
+                              [5, 7, 1, 12], [0, 13, 15, 14]], dtype=torch.int32)
+        table = (pages[:, :, None] * page_size + torch.arange(page_size, dtype=torch.int32)).flatten(1)
+    else:
+        table = torch.arange(4 * 512, dtype=torch.int32).reshape(4, 512)
+    lengths = torch.tensor([129, 128, 385, 257], dtype=torch.int32)
+    forward = types.SimpleNamespace(
+        extend_seq_lens_cpu=[7, 4, 32, 8], seq_lens=lengths.clone(), seq_lens_cpu=lengths,
+        req_pool_indices=torch.tensor([3, 0, 2, 1]), input_ids=torch.zeros(51, dtype=torch.int32),
+    )
+    updater = types.SimpleNamespace(num_qo_heads=28, num_kv_heads=4, head_dim=128,
+                                    q_data_type=torch.bfloat16, data_type=torch.bfloat16)
+    return table, forward, updater
+
+
+class PagedServingTest(unittest.TestCase):
+    def plan_split(self, page_size):
+        table, forward, updater = request_fixture(page_size)
+        calls = []
+
+        class Wrapper:
+            def begin_forward(self, *arguments, **keywords):
+                calls.append(([value.clone() if torch.is_tensor(value) else value
+                               for value in arguments], keywords))
+
+        backend = types.SimpleNamespace(
+            page_size=page_size, req_to_token_pool=types.SimpleNamespace(req_to_token=table),
+            indices_updater_prefill=updater, fused_split_mask=([True, False, True, False], [1] * 4, [1] * 4),
+            fused_split_plans=0, fused_split_onesided=0, fused_fa2_wrapper=Wrapper(),
+            kv_last_page_len=torch.ones(4, dtype=torch.int32),
+            _fs_upload=lambda name, data, dtype, device: torch.tensor(data, dtype=dtype, device=device),
+            _fs_dev_buf=lambda name, count, dtype, device: torch.empty(count, dtype=dtype, device=device),
+        )
+        environment = {
+            "torch": torch, "ForwardBatch": object,
+            "logger": types.SimpleNamespace(info=lambda *args: None, error=lambda *args: None),
+            "FUSED_SPLIT_NO_FA2_WRAPPER": False, "FUSED_SPLIT_DEBUG": False,
+            "FUSED_KERNEL_EXEC": False, "FUSED_NATIVE_PDL": False,
+        }
+        method = extract_method("_fused_split_plan", environment)
+        self.assertTrue(method(backend, forward))
+        return backend, forward, table, calls, method
+
+    def test_page128_split_metadata(self):
+        backend, _, _, calls, _ = self.plan_split(128)
+        arguments, keywords = calls[0]
+        self.assertEqual(arguments[0].tolist(), [0, 4, 12])
+        self.assertEqual(arguments[1].tolist(), [0, 1, 4])
+        self.assertEqual(arguments[2].tolist(), [8, 6, 11, 4])
+        self.assertEqual(arguments[3].tolist(), [128, 1])
+        self.assertEqual(arguments[7], 128)
+        self.assertFalse(keywords["non_blocking"])
+        self.assertEqual(backend.fused_split_plan["page_table"].tolist(),
+                         [[0, 13, 15, 14], [5, 7, 1, 12]])
+        self.assertEqual(backend.fused_split_plan["page_table"].stride(-1), 1)
+        self.assertEqual(backend.fused_split_plan["cache_seqlens"].tolist(), [129, 385])
+        self.assertEqual(backend.fused_split_plan["fa2_tok"].tolist(), list(range(7, 11)) + list(range(43, 51)))
+
+    def test_page_boundary_growth(self):
+        backend, forward, _, calls, method = self.plan_split(128)
+        forward.seq_lens_cpu[1] = 129
+        forward.seq_lens[1] = 129
+        self.assertTrue(method(backend, forward))
+        arguments, _ = calls[1]
+        self.assertEqual(arguments[1].tolist(), [0, 2, 5])
+        self.assertEqual(arguments[2].tolist(), [8, 3, 6, 11, 4])
+        self.assertEqual(arguments[3].tolist(), [1, 1])
+        self.assertEqual(calls[0][0][3].tolist(), [128, 1])
+
+    def test_page1_metadata_is_unchanged(self):
+        backend, _, table, calls, _ = self.plan_split(1)
+        arguments, _ = calls[0]
+        self.assertEqual(arguments[1].tolist(), [0, 128, 385])
+        self.assertEqual(arguments[2].tolist(), torch.cat((table[0, :128], table[1, :257])).tolist())
+        self.assertEqual(arguments[3].tolist(), [1, 1])
+        self.assertEqual(arguments[7], 1)
+        self.assertTrue(torch.equal(backend.fused_split_plan["page_table"], table[[3, 2], :385]))
+
+    def prepare_primary(self, page_size=128, primary_rows=(0, 2)):
+        table, forward, updater = request_fixture(page_size)
+        events, plans, loads = [], [], []
+
+        class Event:
+            def synchronize(self):
+                events.append("wait")
+
+            def record(self):
+                events.append("record")
+
+        def build(*arguments):
+            events.append("build")
+            plans.append(arguments)
+            return [0] * 59
+
+        class TorchProxy:
+            ops = types.SimpleNamespace(paged_test=types.SimpleNamespace(build_fused_plan=build))
+            cuda = types.SimpleNamespace(Event=Event, get_device_properties=lambda device: types.SimpleNamespace(multi_processor_count=132))
+
+            def __getattr__(self, name):
+                return getattr(torch, name)
+
+            def empty(self, size, **keywords):
+                keywords.pop("pin_memory", None)
+                return torch.empty(min(size, 128), **keywords)
+
+        environment = {"torch": TorchProxy(), "os": os, "FUSED_NATIVE_PDL": True,
+                       "FUSED_SPLIT_VERIFY": True, "logger": types.SimpleNamespace(info=lambda *args: None)}
+        method = extract_method("_prepare_fused_kernel_plan", environment)
+        loader_name = "sglang.srt.layers.attention.fused_fa3_loader"
+        loader = types.ModuleType(loader_name)
+
+        def load(**keywords):
+            loads.append(keywords)
+            return "paged_test"
+
+        loader.load_fused_fa3 = load
+        flashinfer = types.ModuleType("flashinfer")
+
+        def unused_wrapper(*arguments, **keywords):
+            raise AssertionError("The native primary must not construct the legacy FA3 wrapper")
+
+        flashinfer.BatchPrefillWithPagedKVCacheWrapper = unused_wrapper
+        backend = types.SimpleNamespace(page_size=page_size, _fused_kernel_state=None,
+                                        req_to_token_pool=types.SimpleNamespace(req_to_token=table))
+        plan = {}
+        primary = np.array(primary_rows, dtype=np.int64)
+        secondary = np.array([row for row in range(4) if row not in primary_rows], dtype=np.int64)
+        settings = {"FUSED_PAGED_TMA_BUILD": "1", "FUSED_FA3_CTA_Q": "128",
+                    "SGLANG_FUSED_SM_FA3": "112", "SGLANG_FUSED_KERNEL_DEBUG": "0"}
+        with patch.dict(sys.modules, {loader_name: loader, "flashinfer": flashinfer}), patch.dict(os.environ, settings):
+            for repeat in range(2):
+                method(backend, forward, plan, primary, secondary, np.array(forward.extend_seq_lens_cpu),
+                       forward.seq_lens_cpu, forward.req_pool_indices.tolist(),
+                       np.array([0, 7, 11, 43, 51]), updater, torch.device("cpu"))
+        return plan["fused_kernel"], plans, loads, events
